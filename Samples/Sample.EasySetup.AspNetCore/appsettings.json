{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "Rollbar": {
    "AccessToken": "your-access-token-here",
    "Environment": "development",
    "ScrubFields": ["password", "secret", "token"],
    "MinLevel": "Info",
    "Enabled": true,
    "Transmit": true
  }
}