{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HangfireConnection": "Server=(localdb)\\mssqllocaldb;Database=HangfireRollbarSample;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "Rollbar": {
    "AccessToken": "your-rollbar-access-token-here",
    "Environment": "development",
    "Enabled": true,
    "Transmit": false
  }
}